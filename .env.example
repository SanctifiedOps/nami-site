# Mailchimp Marketing API
# Get from: Mailchimp > Account & billing > Extras > API keys
# Format: <32 hex chars>-<dc>  (e.g. xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21)
# The suffix after the dash is the data-center prefix and is required.
MAILCHIMP_API_KEY=

# Mailchimp Audience (List) ID
# Get from: Mailchimp > Audience > Settings > Audience name and defaults > Audience ID
# Looks like: 1a2b3c4d5e
MAILCHIMP_AUDIENCE_ID=

# Make.com webhook for the contact-form intake scenario.
# Created in Make as a "Custom webhook" trigger; copy the URL it generates.
# Fires for every successful contact form submission with the full payload.
CONTACT_WEBHOOK_URL=

# Google Analytics 4 measurement ID.
# Format: G-XXXXXXXXXX (Admin > Data streams > Web stream details).
# Public — embedded in client HTML — but kept in env so it can be left
# unset locally (no analytics fire in dev).
NEXT_PUBLIC_GA_ID=
